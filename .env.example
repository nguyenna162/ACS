# ACS - mẫu biến môi trường triển khai native (copy thành .env hoặc set trong service)
# Profile: dev | prod | test
ACS_ENV=prod
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=thay-bang-chuoi-ngau-nhien-toi-thieu-50-ky-tu
DJANGO_ALLOWED_HOSTS=acs.factory.local,10.20.30.11
DJANGO_CSRF_TRUSTED_ORIGINS=https://acs.factory.local
DJANGO_TIME_ZONE=Asia/Ho_Chi_Minh
DJANGO_LANGUAGE_CODE=vi

# Cơ sở dữ liệu PostgreSQL nội bộ (SQLite chỉ dùng dev/test)
ACS_DB_ENGINE=postgresql
POSTGRES_DB=acs_db
POSTGRES_USER=acs_user
POSTGRES_PASSWORD=thay-bang-mat-khau-manh
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
ACS_DB_CONN_MAX_AGE=60
ACS_DB_STATEMENT_TIMEOUT_MS=15000

# Xác thực API (production bắt buộc true)
ACS_REQUIRE_AUTH=true
ACS_CORS_ALLOWED_ORIGINS=https://hmi.factory.local
ACS_CORS_ALLOW_ALL=false
ACS_THROTTLE_CONTROL=60/min

# Broker MQTT: EMQX/Mosquitto trong nhà máy (TLS khuyến nghị)
MQTT_BROKER=10.20.30.10
MQTT_PORT=8883
MQTT_USERNAME=acs_controller
MQTT_PASSWORD=thay-bang-mat-khau-mqtt
MQTT_CA_CERTS=/etc/acs/certs/ca.crt
MQTT_CLIENT_CERT=/etc/acs/certs/acs-controller.crt
MQTT_CLIENT_KEY=/etc/acs/certs/acs-controller.key
MQTT_TLS_INSECURE=false
MQTT_QOS=1
MQTT_CLIENT_ID_PREFIX=ACS_CONTROLLER
VDA5050_TOPIC_PREFIX=vda5050/v2

# Điều phối / an toàn vận hành
ACS_HORIZON_WINDOW_K=3
ACS_MIN_BATTERY_PERCENT=25
ACS_DISPATCH_W1_DISTANCE=0.7
ACS_DISPATCH_W2_BATTERY=0.3
ACS_D_MAX_MAP=100
ACS_AUTO_REGISTER_ROBOTS=false
ACS_REQUIRE_ACTION_FEEDBACK=false
ACS_RESERVATION_TTL_SECONDS=45
ACS_HEARTBEAT_WARNING_SECONDS=5
ACS_HEARTBEAT_OFFLINE_SECONDS=10
ACS_ORDER_QUEUE_TIMEOUT_SECONDS=600
ACS_ORDER_MAX_QUEUE=500

# Worker pipeline (acs_order_master / acs_order_send)
ACS_WORKER_LOOP_SLEEP_SECONDS=0.5
ACS_SENT_TIMEOUT_SECONDS=300
ACS_RESEND_INTERVAL_SECONDS=3
ACS_ORDER_MASTER_POOL=3
ACS_PAIRING_BATCH_SIZE=50
ACS_MAX_CACHE_SIZE=20000

# Hiệu năng 50 AMR / lưu trữ
ACS_STATE_FLUSH_INTERVAL_SECONDS=0.5
ACS_TELEMETRY_SAMPLE_SECONDS=5
ACS_TELEMETRY_RETENTION_DAYS=7
ACS_EVENT_RETENTION_SECONDS=3600
ACS_OUTBOX_RETENTION_DAYS=7
ACS_WS_SNAPSHOT_INTERVAL_SECONDS=1
ACS_WORKER_STALE_SECONDS=20

# Log / media
ACS_LOG_DIR=/var/log/acs
ACS_LOG_LEVEL=INFO
ACS_MEDIA_ROOT=/var/lib/acs/media

# Aligo MES (tắt nếu nhà máy offline; bật khi có kết nối MES)
ALIGO_ENABLED=false
ALIGO_BASE_URL=
ALIGO_API_KEY=
ALIGO_POLL_INTERVAL_SECONDS=3
ALIGO_TIMEOUT_SECONDS=5
